# Database Configuration
# For Docker: postgresql://stanovi_user:stanovi_password@postgres:5432/stanovi_db?schema=public
# For Local: postgresql://user:password@localhost:5432/stanovi_db?schema=public
DATABASE_URL=

# JWT Secret Key
# Generate a strong secret with at least 32 characters
# Example: openssl rand -base64 32
JWT_SECRET=

# Server Port
PORT=3000

# Kafka Configuration
# For Docker use: kafka:29092
# For local development use: localhost:9092
KAFKA_BROKERS=

# Kafka Client ID
KAFKA_CLIENT_ID=stanovi-api

# Cloudinary Configuration
# Your Cloudinary cloud name (found in Cloudinary dashboard)
CLOUDINARY_CLOUD_NAME=

# Cloudinary API key for authentication (found in Cloudinary dashboard)
CLOUDINARY_API_KEY=

# Cloudinary API secret for authentication (found in Cloudinary dashboard)
CLOUDINARY_API_SECRET=

# Cloudinary Upload Folder
CLOUDINARY_UPLOAD_FOLDER=stanovi-platforma/buildings