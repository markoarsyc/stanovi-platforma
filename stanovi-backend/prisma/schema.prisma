generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//
// ENUMS
//

enum Role {
  BUYER
  INVESTOR
  ADMIN
}

enum BuildingStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

enum ApartmentStatus {
  AVAILABLE
  RESERVED
}

//
// MODELS
//

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  buyer        Buyer?
  investor     Investor?
}

model Buyer {
  id        String   @id @default(uuid())
  userId    String   @unique
  firstName String
  lastName  String
  phone     String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model Investor {
  id            String   @id @default(uuid())
  userId        String   @unique
  companyName   String
  tin           String?  @unique
  contactEmail  String
  contactPhone  String
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  buildings     Building[]
}

model Location {
  id     Int      @id
  name   String   @unique

  buildings Building[]
}

model Building {
  id            String          @id @default(uuid())
  investorId    String
  locationId    Int
  title         String
  address       String
  description   String?
  dueDate  DateTime
  status        BuildingStatus
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  investor      Investor        @relation(fields: [investorId], references: [id], onDelete: Restrict)
  location      Location        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  apartments    Apartment[]
  images        BuildingImage[]

  @@index([investorId])
  @@index([locationId])
}

model BuildingImage {
  id            String          @id @default(uuid())
  buildingId    String
  imageUrl      String
  publicId      String          @unique
  displayOrder  Int             @default(0)
  createdAt     DateTime        @default(now())

  building      Building        @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@index([buildingId])
  @@index([displayOrder])
}

model ApartmentImage {
  id            String          @id @default(uuid())
  apartmentId   String
  imageUrl      String
  publicId      String          @unique
  displayOrder  Int             @default(0)
  createdAt     DateTime        @default(now())

  apartment     Apartment       @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  @@index([apartmentId])
  @@index([displayOrder])
}

model Apartment {
  id         String           @id @default(uuid())
  buildingId String
  aptNo      String
  floor      Int
  rooms      Int
  area       Decimal          @db.Decimal(10,2)
  price      Decimal          @db.Decimal(12,2)
  status     ApartmentStatus  @default(AVAILABLE)
  createdAt  DateTime         @default(now())

  building   Building         @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  images     ApartmentImage[]

  @@unique([buildingId, aptNo])
  @@index([buildingId])
}
